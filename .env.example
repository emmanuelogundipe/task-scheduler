# ============================================================
# Database (PostgreSQL)
# Local:  docker compose up -d  →  postgresql://taskscheduler:taskscheduler@localhost:5432/taskscheduler
# Render: auto-configured by render.yaml (free PostgreSQL instance)
# ============================================================
DATABASE_URL="postgresql://taskscheduler:taskscheduler@localhost:5432/taskscheduler"

# ============================================================
# WhatsApp — UltraMsg API (FREE tier available)
# Sign up at https://ultramsg.com → create an instance → copy Instance ID + Token
# ============================================================
ULTRA_INSTANCE_ID=""
ULTRA_TOKEN=""

# ============================================================
# Email — Gmail SMTP (FREE)
# 1. Enable 2FA on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below
# ============================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ifywayne@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Task Scheduler <ifywayne@gmail.com>"

# ============================================================
# Google Calendar OAuth2 (FREE)
# 1. https://console.cloud.google.com → create project
# 2. Enable "Google Calendar API"
# 3. Credentials → Create OAuth Client ID (Web)
# 4. Add redirect URI: http://localhost:3000/api/google/callback (local)
#    or https://your-domain.com/api/google/callback (production)
# ============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ============================================================
# Scheduler
# How often (minutes) each task handler receives a periodic
# WhatsApp status reminder while a task is In Progress.
# ============================================================
REMINDER_INTERVAL_MIN="30"
