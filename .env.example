# ============================================================
# Database (SQLite via Prisma — no external DB server needed)
# ============================================================
DATABASE_URL="file:./dev.db"

# ============================================================
# WhatsApp — UltraMsg API (https://ultramsg.com)
# Create an account, add an instance, then copy the
# Instance ID and Token from the UltraMsg dashboard.
# ============================================================
ULTRA_INSTANCE_ID=""
ULTRA_TOKEN=""

# ============================================================
# Email — Nodemailer SMTP
# Works with Gmail (use an App Password), Mailgun, SendGrid,
# Brevo, your office SMTP relay, etc.
# ============================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Task Scheduler <no-reply@example.com>"

# ============================================================
# Google Calendar OAuth2
# 1. Create a project in Google Cloud Console
# 2. Enable the "Google Calendar API"
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add your redirect URI below to "Authorized redirect URIs"
# ============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ============================================================
# Scheduler
# How often (minutes) each task handler receives a periodic
# WhatsApp status reminder while a task is In Progress.
# ============================================================
REMINDER_INTERVAL_MIN="30"
