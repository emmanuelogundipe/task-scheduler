# ============================================================
# Odyssey Scheduler — Environment Configuration
# Task Management & WhatsApp Reminders
# ============================================================

# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Free cloud option: Neon (https://neon.tech) — no credit card required.
# Example: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Local Docker: postgresql://odyssey:odyssey@localhost:5432/odyssey
DATABASE_URL="postgresql://odyssey:odyssey@localhost:5432/odyssey"

# Authentication (optional — sessions are random DB-backed tokens)
SESSION_SECRET="change-me-to-a-long-random-string"

# UltraMsg WhatsApp (ONLY external integration)
# Sign up at https://ultramsg.com → create an instance → copy the
# Instance ID and Token from the UltraMsg dashboard.
ULTR_INSTANCE_ID=""
ULTRA_TOKEN=""

# Scheduler / timezone
TASK_REMINDER_INTERVAL_MINUTES=30
APP_TIMEZONE="Africa/Lagos"

# Optional: enable the /api/cron/run endpoint for external crons on
# hosts where the in-process scheduler cannot run continuously.
CRON_SECRET=""
