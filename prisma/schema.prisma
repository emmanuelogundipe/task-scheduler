// ============================================================
// Odyssey Scheduler — Task Management & WhatsApp Reminders
// Database Schema (SQLite — lightweight, standalone deployment)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Settings — the single application settings row (id = 1)
// Holds the admin profile + configurable reminder interval.
// The admin passcode is stored as a bcrypt hash only.
// ------------------------------------------------------------
model Settings {
  id                      Int      @id @default(autoincrement())
  adminName               String   @default("Engr. Mrs. Stella")
  adminWhatsapp           String   @default("+2348133226669")
  adminPasscodeHash       String
  reminderIntervalMinutes Int      @default(30)
  timezone                String   @default("Africa/Lagos")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ------------------------------------------------------------
// User — administrators and task handlers
// ------------------------------------------------------------
model User {
  id           Int      @id @default(autoincrement())
  name         String
  whatsappNumber String  @unique
  role         String   @default("TASK_HANDLER") // ADMIN | TASK_HANDLER
  status       String   @default("ACTIVE")       // ACTIVE | INACTIVE
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  assignedTasks       Task[]    @relation("AssignedTasks")
  approvedTasks       Task[]    @relation("ApprovedTasks")
  notificationLogs    NotificationLog[]
  auditLogs           AuditLog[]
}

// ------------------------------------------------------------
// Session — secure httpOnly cookie sessions
// ------------------------------------------------------------
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ------------------------------------------------------------
// Task — unlimited tasks with milestone/reminder flags so the
// scheduler never sends the same notification twice, even
// across server restarts.
// ------------------------------------------------------------
model Task {
  id                    Int       @id @default(autoincrement())
  title                 String
  description           String    @default("")
  status                String    @default("IN_PROGRESS")
  // IN_PROGRESS | PENDING_APPROVAL | COMPLETED | OVERDUE | CANCELLED
  startDateTime         DateTime
  deadlineDateTime      DateTime
  durationMinutes       Int
  progressPercentage    Int       @default(0)
  assignedToId          Int
  assignedTo            User      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  approvedById          Int?
  approvedBy            User?     @relation("ApprovedTasks", fields: [approvedById], references: [id])

  milestone50Sent       Boolean   @default(false)
  milestone70Sent       Boolean   @default(false)
  deadlineNotificationSent Boolean @default(false)
  lastReminderAt        DateTime?
  // How many of the 5 pre-deadline reminder intervals have already
  // been sent. Reminders go to BOTH the admin and the handler each
  // time, and each of the 5 intervals fires at most once.
  remindersSent         Int       @default(0)

  completedAt           DateTime?
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  notificationLogs      NotificationLog[]
  auditLogs             AuditLog[]

  @@index([status])
  @@index([assignedToId])
  @@index([deadlineDateTime])
}

// ------------------------------------------------------------
// NotificationLog — every WhatsApp attempt is recorded here
// ------------------------------------------------------------
model NotificationLog {
  id               Int       @id @default(autoincrement())
  taskId           Int?
  task             Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  recipientUserId  Int?
  recipient        User?     @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientWhatsApp String
  notificationType String
  // TASK_ASSIGNED | TASK_REMINDER | MILESTONE_50 | MILESTONE_70 |
  // DEADLINE_REACHED | TEST_MESSAGE | TASK_COMPLETED | STATUS_CHANGE
  message          String
  provider         String    @default("ULTRAMSG")
  status           String    @default("PENDING") // SENT | FAILED | PENDING
  providerResponse String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([taskId])
  @@index([recipientUserId])
  @@index([notificationType])
  @@index([status])
}

// ------------------------------------------------------------
// AuditLog — important system + administrative events
// ------------------------------------------------------------
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  taskId    Int?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  details   String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
